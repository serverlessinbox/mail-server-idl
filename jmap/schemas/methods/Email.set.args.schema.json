{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://serverlessinbox.com/schemas/jmap/methods/Email.set.args.schema.json",
  "title": "Email/set args",
  "$defs": {
    "CreationId": {
      "type": "string",
      "minLength": 1
    },
    "PatchObject": {
      "type": "object",
      "description": "JMAP PatchObject: keys are JSON Pointers to properties; values are the new values (or null to remove).",
      "properties": {
        "keywords": {
          "description": "Replacement keywords; each value is true. null resets to the default empty set (RFC 8620 §5.3).",
          "anyOf": [
            { "type": "object", "additionalProperties": { "type": "boolean", "enum": [true] } },
            { "type": "null" }
          ]
        },
        "mailboxIds": {
          "type": "object",
          "description": "Replacement mailbox set; each value is true. At least one entry (RFC 8621 §4.1.1).",
          "minProperties": 1,
          "additionalProperties": { "type": "boolean", "enum": [true] }
        }
      },
      "patternProperties": {
        "^/": {},
        "^keywords/": { "description": "Set (true) or remove (null) one keyword.", "enum": [true, null] },
        "^mailboxIds/": { "description": "Add (true) or remove (null) one mailbox.", "enum": [true, null] }
      }
    }
  },
  "type": "object",
  "properties": {
    "accountId": { "$ref": "../core/types.schema.json#/$defs/AccountId", "description": "The account to apply changes to." },
    "ifInState": { "type": ["string", "null"], "minLength": 1, "description": "Optimistic concurrency guard; the call fails with stateMismatch if the Email state has changed." },

    "create": {
      "type": "object",
      "description": "Map of client-assigned creation ids to Email objects.",
      "propertyNames": { "$ref": "#/$defs/CreationId" },
      "additionalProperties": { "$ref": "../core/types.schema.json#/$defs/EmailCreate" }
    },

    "update": {
      "type": "object",
      "description": "Map of EmailId to PatchObject.",
      "propertyNames": { "$ref": "../core/types.schema.json#/$defs/EmailId" },
      "additionalProperties": { "$ref": "#/$defs/PatchObject" }
    },

    "destroy": {
      "type": "array",
      "description": "List of EmailIds to permanently delete.",
      "items": { "$ref": "../core/types.schema.json#/$defs/EmailId" }
    }
  },
  "required": ["accountId"]
}
